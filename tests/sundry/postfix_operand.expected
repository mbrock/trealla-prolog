default:
[3 fact, 1]  ->  [3 fact,1]
[1, 3 fact, 2]  ->  [1,3 fact,2]
[3 fact|t]  ->  [3 fact|t]
[a +, 1]  ->  err(syntax_error)
0''  ->  0 ''
0''   ->  0 ''
f(0'', a)  ->  f(0 '',a)
[0'', 1]  ->  [0 '',1]
(0''; a)  ->  0 '' ;a
0''1  ->  0''1
0'' 1  ->  0''1
0''  ->  err(syntax_error)
0'''  ->  39
strict_iso:
[3 fact, 1]  ->  [3 fact,1]
[1, 3 fact, 2]  ->  [1,3 fact,2]
[3 fact|t]  ->  [3 fact|t]
[a +, 1]  ->  err(syntax_error)
0''  ->  0 ''
0''   ->  0 ''
f(0'', a)  ->  f(0 '',a)
[0'', 1]  ->  [0 '',1]
(0''; a)  ->  0 '' ;a
0''1  ->  0''1
0'' 1  ->  0''1
0''  ->  err(syntax_error)
0'''  ->  39
